# Copy to .env and fill in. NEVER commit .env.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
TELEGRAM_BOT_TOKEN=123456789:ABCdEf-yourbottoken

# Your numeric Telegram user id (see RUNBOOK). Only this id may talk to the bot.
ALLOWED_TELEGRAM_USER_ID=000000000

# Model strings (update if Anthropic ships newer ones).
MODEL_REASONING=claude-sonnet-4-6
MODEL_ROUTING=claude-haiku-4-5-20251001
# OpenAI key — used ONLY for Tier 2 embeddings (text-embedding-3-small). Claude
# is still the brain. Get one at platform.openai.com (needs a little credit).
OPENAI_API_KEY=sk-proj-xxxxxxxx

# Local Postgres (Tier 2 memory). Used by docker-compose AND the app (step 3).
# Any value is fine locally; it just needs to match between the two.
POSTGRES_PASSWORD=localdev
# DATABASE_URL is optional: if unset, the app builds it from POSTGRES_PASSWORD
# (postgresql://assistant:<password>@localhost:5432/assistant). Set it explicitly
# only to point at a different/remote Postgres later.
# DATABASE_URL=postgresql://assistant:localdev@localhost:5432/assistant

# Calendar (Phase 2). IANA timezone used to interpret "3pm" and display events.
# The OAuth client (config/credentials.json) and token (config/token.json) are files,
# not env vars — see the Google setup steps.
CALENDAR_TIMEZONE=America/Santo_Domingo
